# ChronaNexus Backend Environment Variables
PROJECT_NAME="ChronaNexus Medical Intelligence Platform"
API_V1_STR="/api/v1"
SECRET_KEY="chronanexus-super-secure-change-in-production-secret-key-32bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite for local development; set to PostgreSQL for production)
DATABASE_URL="sqlite:///./chronanexus.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/chronanexus"

# Storage Configuration ('local' or 's3')
STORAGE_BACKEND="local"
UPLOAD_DIR="./uploads"

# Embeddings & Vector Search Configuration ('ollama' or 'local')
EMBEDDING_PROVIDER="ollama"
OLLAMA_EMBEDDING_MODEL="all-minilm"
EMBEDDING_DIMENSION=384

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
