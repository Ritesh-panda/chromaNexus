# ============================================================
# ChronaNexus Environment Configuration Template
# ============================================================

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend Core & Security
SECRET_KEY=chronanexus-super-secure-change-in-production-secret-key-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database & Storage
DATABASE_URL=sqlite:///./chronanexus.db
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads

# AI & LLM Provider Configuration
# Supported providers: 'ollama', 'gemini', 'mock'
LLM_PROVIDER=ollama

# Ollama Local Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Google Gemini Cloud Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Embeddings & Chunking Configuration
EMBEDDING_PROVIDER=local
CHUNK_SIZE=500
CHUNK_OVERLAP=100
