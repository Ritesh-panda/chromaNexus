# =====================================================================
# ChronaNexus — Configuration Template (.env.example)
# Privacy-First Longitudinal Medical Intelligence Platform
# =====================================================================
# NOTE: Safe placeholders only. Never commit real credentials or keys.

# --- Application Core ---
PROJECT_NAME="ChronaNexus Medical Intelligence Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"              # 'development', 'staging', 'production'
LOG_LEVEL="INFO"                       # 'DEBUG', 'INFO', 'WARNING', 'ERROR'
STRICT_SECURITY=false                  # true in production: requires strong keys

# --- Security & JWT Authentication ---
# In production, generate a cryptographically strong 32-byte secret:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="chronanexus-super-secure-change-in-production-secret-key-32bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440       # 24 hours

# --- Relational Database ---
# Default SQLite local database (single-process desktop / development):
DATABASE_URL="sqlite:///./chronanexus.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/chronanexus"

# --- Storage Tier ---
STORAGE_BACKEND="local"                # 'local' or 's3'
UPLOAD_DIR="./uploads"

# --- Vector Store & Embeddings ---
VECTOR_STORE_BACKEND="chroma"          # 'chroma', 'postgres', 'in_memory'
CHROMA_PERSIST_DIRECTORY="./data/chroma_db"
CHROMA_COLLECTION_NAME="chronanexus_clinical_chunks"

# Embedding Provider:
# 'ollama' (recommended local private embeddings), 'local' (deterministic lightweight)
EMBEDDING_PROVIDER="ollama"
OLLAMA_EMBEDDING_MODEL="all-minilm"
EMBEDDING_DIMENSION=384

# --- Ingestion & Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=100
OCR_PROVIDER="auto"                    # 'auto', 'tesseract', 'mock'

# --- LLM Inference Provider (Zero Telemetry by Default) ---
# Supported options: 'ollama' (private local model), 'mock' (offline test), 'gemini' (cloud opt-in)
LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"

# Optional Cloud Inference (disabled by default; requires explicit opt-in):
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-1.5-flash"

# --- Cross-Origin Resource Sharing (CORS) ---
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# --- Frontend Client Configuration ---
VITE_API_BASE_URL="http://localhost:8000/api/v1"
